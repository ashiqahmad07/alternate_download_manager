<local:ThemedWindow x:Class="ADM.App.DuplicateLinkWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:ADM.App"
        xmlns:local="clr-namespace:ADM.App"
        Title="{l:T duplicatelink.duplicate_download_link}" Width="520" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="True">
    <StackPanel Margin="18">
        <TextBlock Text="{l:T duplicatelink.this_link_is_already_in_your}" />
        <TextBlock x:Name="NameText" FontWeight="SemiBold" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
        <TextBlock x:Name="StatusText" Foreground="{DynamicResource MutedText}" Margin="0,2,0,14" TextTrimming="CharacterEllipsis" />

        <RadioButton x:Name="NumberedOption" Content="{l:T duplicatelink.add_it_again_with_numbered_file}" IsChecked="True" />
        <RadioButton x:Name="OverwriteOption" Content="{l:T duplicatelink.add_it_again_and_overwrite_existing}" Margin="0,8,0,0" />
        <!-- These two are the longest here, and a translation is often longer still. A text inside isn't read as the control's name, so it's given too. -->
        <RadioButton x:Name="ResumeOption" AutomationProperties.Name="{l:T duplicatelink.keep_existing_download_resume_it_or}" Margin="0,8,0,0">
            <TextBlock Text="{l:T duplicatelink.keep_existing_download_resume_it_or}" TextWrapping="Wrap" />
        </RadioButton>

        <CheckBox x:Name="RememberBox" Margin="0,16,0,0" AutomationProperties.Name="{l:T duplicatelink.remember_my_choice_and_dont_ask}">
            <TextBlock Text="{l:T duplicatelink.remember_my_choice_and_dont_ask}" TextWrapping="Wrap" />
        </CheckBox>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Style="{StaticResource DialogButton}" Content="{l:T common.ok}" IsDefault="True" Click="Ok_Click" />
            <Button Style="{StaticResource DialogButton}" Content="{l:T common.cancel}" IsCancel="True" />
        </StackPanel>
    </StackPanel>
</local:ThemedWindow>
