<local:ThemedWindow x:Class="ADM.App.PropertiesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:ADM.App"
        xmlns:local="clr-namespace:ADM.App"
        Title="{l:T properties.properties}" Width="640" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="True">
    <StackPanel Margin="18">
        <DockPanel>
            <Image x:Name="FileIcon" Width="32" Height="32" Margin="0,0,12,0" VerticalAlignment="Top" />
            <StackPanel>
                <TextBox x:Name="NameText" FontWeight="SemiBold" IsReadOnly="True" BorderThickness="0" Background="Transparent"
                         AutomationProperties.Name="{l:T common.file_name}" />
                <TextBlock x:Name="TypeText" Foreground="{DynamicResource MutedText}" Margin="2,0,0,0" />
            </StackPanel>
        </DockPanel>

        <Grid Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Style="{StaticResource FieldLabel}" Text="{l:T common.status}" />
            <TextBlock x:Name="StatusValue" Grid.Column="1" Grid.ColumnSpan="2" TextWrapping="Wrap" />

            <TextBlock Grid.Row="1" Style="{StaticResource FieldLabel}" Text="{l:T common.size}" Margin="0,6,10,0" />
            <TextBlock x:Name="SizeValue" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,6,0,0" />

            <TextBlock Grid.Row="2" Style="{StaticResource FieldLabel}" Text="{l:T properties.last_try}" Margin="0,6,10,0" />
            <TextBlock x:Name="LastTryValue" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,6,0,0" TextWrapping="Wrap" />

            <TextBlock Grid.Row="3" Style="{StaticResource FieldLabel}" Text="{l:T common.save_to}" Margin="0,14,10,0" />
            <TextBox x:Name="FolderBox" Grid.Row="3" Grid.Column="1" Padding="4,3" Margin="0,14,0,0" AutomationProperties.Name="{l:T common.save_to}" />
            <Button x:Name="BrowseButton" Grid.Row="3" Grid.Column="2" Content="{l:T common.browse}" Padding="10,3" Margin="6,14,0,0" Click="Browse_Click" />

            <TextBlock Grid.Row="4" Style="{StaticResource FieldLabel}" Text="{l:T common.address}" Margin="0,10,10,0" />
            <TextBox x:Name="UrlBox" Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2" Padding="4,3" Margin="0,10,0,0" AutomationProperties.Name="{l:T common.address}" />

            <TextBlock Grid.Row="5" Style="{StaticResource FieldLabel}" Text="{l:T common.description}" Margin="0,10,10,0" />
            <TextBox x:Name="DescriptionBox" Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="2" Padding="4,3" Margin="0,10,0,0" AutomationProperties.Name="{l:T common.description}" />

            <TextBlock Grid.Row="6" Style="{StaticResource FieldLabel}" Text="{l:T properties.referer}" Margin="0,10,10,0" />
            <TextBox x:Name="RefererBox" Grid.Row="6" Grid.Column="1" Grid.ColumnSpan="2" Padding="4,3" Margin="0,10,0,0" AutomationProperties.Name="{l:T properties.referer}" />

            <TextBlock Grid.Row="7" Style="{StaticResource FieldLabel}" Text="{l:T properties.came_from}" Margin="0,10,10,0" />
            <TextBox x:Name="PageBox" Grid.Row="7" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,10,0,0" Padding="4,3"
                     IsReadOnly="True" BorderThickness="0" Background="Transparent" AutomationProperties.Name="{l:T properties.parent_web_page}" />

            <TextBlock x:Name="HashLabel" Grid.Row="9" Style="{StaticResource FieldLabel}" Text="{l:T common.sha256}" Margin="0,10,10,0" />
            <StackPanel x:Name="HashPanel" Grid.Row="9" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,10,0,0">
                <TextBox x:Name="HashBox" Padding="4,3" AutomationProperties.Name="{l:T common.sha256}" ToolTip="{l:T common.sha256_hint}" />
                <TextBlock x:Name="HashResultText" Margin="0,4,0,0" TextWrapping="Wrap" Foreground="{DynamicResource MutedText}" />
            </StackPanel>

            <TextBlock Grid.Row="8" Style="{StaticResource FieldLabel}" Text="{l:T properties.login}" Margin="0,10,10,0" />
            <Grid Grid.Row="8" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource FieldLabel}" Text="{l:T common.user_name}" />
                <TextBox x:Name="LoginUserBox" Grid.Column="1" Padding="4,3" AutomationProperties.Name="{l:T common.user_name}" />
                <TextBlock Grid.Column="2" Style="{StaticResource FieldLabel}" Margin="12,0,10,0" Text="{l:T common.password}" />
                <PasswordBox x:Name="LoginPasswordBox" Grid.Column="3" Padding="4,3" AutomationProperties.Name="{l:T common.password}"
                             ToolTip="{l:T properties.leave_empty_to_keep_saved_password}" />
            </Grid>
        </Grid>

        <TextBlock x:Name="RunningNote" Margin="0,12,0,0" Foreground="{DynamicResource MutedText}" Visibility="Collapsed"
                   Text="{l:T properties.pause_download_to_change_folder_address}" />

        <DockPanel Margin="0,20,0,0" LastChildFill="False">
            <Button x:Name="OpenButton" DockPanel.Dock="Left" Style="{StaticResource DialogButton}" Margin="0" Content="{l:T common.open}" Click="Open_Click" />
            <Button DockPanel.Dock="Right" Style="{StaticResource DialogButton}" Content="{l:T common.cancel}" IsCancel="True" />
            <Button DockPanel.Dock="Right" Style="{StaticResource DialogButton}" Content="{l:T common.ok}" IsDefault="True" Click="Ok_Click" />
        </DockPanel>
    </StackPanel>
</local:ThemedWindow>
