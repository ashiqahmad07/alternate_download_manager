<local:ThemedWindow x:Class="ADM.App.CountdownWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:ADM.App"
        xmlns:local="clr-namespace:ADM.App"
        Title="{l:T countdown.queue_finished}" Width="440" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" Topmost="True" ShowInTaskbar="True">
    <StackPanel Margin="18">
        <TextBlock x:Name="MessageText" TextWrapping="Wrap" />
        <TextBlock x:Name="CountText" Margin="0,10,0,0" FontSize="{DynamicResource AppFontSizeTitle}" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="{DynamicResource AccentText}" />
        <TextBlock x:Name="OthersText" Margin="0,8,0,0" TextWrapping="Wrap" Foreground="{DynamicResource MutedText}" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="NowButton" Style="{StaticResource DialogButton}" Click="Now_Click" />
            <Button Style="{StaticResource DialogButton}" Content="{l:T common.cancel}" IsDefault="True" Click="Cancel_Click" />
        </StackPanel>
    </StackPanel>
</local:ThemedWindow>
