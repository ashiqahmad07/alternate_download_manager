<local:ThemedWindow x:Class="ADM.App.ProgressWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:ADM.App"
        xmlns:local="clr-namespace:ADM.App"
        Title="ADM" Width="540" SizeToContent="Height" ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="True">
    <TabControl x:Name="Tabs" Margin="10">
        <TabItem Header="{l:T progress.download_status}">
            <StackPanel Margin="12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Style="{StaticResource FieldLabel}" Text="{l:T common.address}" />
                    <TextBox x:Name="UrlText" Grid.Column="1" IsReadOnly="True" BorderThickness="0" Background="Transparent" AutomationProperties.Name="{l:T common.address}" />
                    <TextBlock Grid.Row="1" Style="{StaticResource FieldLabel}" Text="{l:T common.status}" Margin="0,6,10,0" />
                    <TextBlock x:Name="StatusValue" Grid.Row="1" Grid.Column="1" Margin="0,6,0,0" TextWrapping="Wrap" />
                    <TextBlock Grid.Row="2" Style="{StaticResource FieldLabel}" Text="{l:T progress.file_size}" Margin="0,6,10,0" />
                    <TextBlock x:Name="SizeValue" Grid.Row="2" Grid.Column="1" Margin="0,6,0,0" />
                    <TextBlock Grid.Row="3" Style="{StaticResource FieldLabel}" Text="{l:T progress.downloaded}" Margin="0,6,10,0" />
                    <TextBlock x:Name="DownloadedValue" Grid.Row="3" Grid.Column="1" Margin="0,6,0,0" />
                    <TextBlock Grid.Row="4" Style="{StaticResource FieldLabel}" Text="{l:T progress.transfer_rate}" Margin="0,6,10,0" />
                    <TextBlock x:Name="RateValue" Grid.Row="4" Grid.Column="1" Margin="0,6,0,0" />
                    <TextBlock Grid.Row="5" Style="{StaticResource FieldLabel}" Text="{l:T progress.time_left}" Margin="0,6,10,0" />
                    <TextBlock x:Name="TimeLeftValue" Grid.Row="5" Grid.Column="1" Margin="0,6,0,0" />
                    <TextBlock Grid.Row="6" Style="{StaticResource FieldLabel}" Text="{l:T progress.can_resume}" Margin="0,6,10,0" />
                    <TextBlock x:Name="ResumeValue" Grid.Row="6" Grid.Column="1" Margin="0,6,0,0" />
                </Grid>
                <ProgressBar x:Name="Bar" Height="16" Margin="0,12,0,0" Maximum="100"
                             AutomationProperties.Name="{l:T progress.progress}" />

                <StackPanel x:Name="DetailsPanel" Visibility="Collapsed" Margin="0,12,0,0">
                    <TextBlock HorizontalAlignment="Center" Margin="0,0,0,4" Foreground="{DynamicResource MutedText}" Text="{l:T progress.start_positions}" />
                    <local:SegmentBar x:Name="Segments" Height="14" AutomationProperties.Name="{l:T progress.start_positions}" />
                    <Grid Height="130" Margin="0,8,0,0">
                        <DataGrid x:Name="ConnectionsGrid" AutoGenerateColumns="False" IsReadOnly="True"
                                  HeadersVisibility="Column" GridLinesVisibility="None" CanUserSortColumns="False" AutomationProperties.Name="{l:T common.connections}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="{l:T progress.n}" Binding="{Binding Number}" Width="40" />
                                <DataGridTextColumn Header="{l:T progress.downloaded}" Binding="{Binding Downloaded}" Width="120" />
                                <DataGridTextColumn Header="{l:T progress.info}" Binding="{Binding Info}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock x:Name="NoConnectionsText" Visibility="Collapsed" IsHitTestVisible="False" TextWrapping="Wrap" TextAlignment="Center"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" Margin="16,24,16,0"
                                   Foreground="{DynamicResource MutedText}" Text="{l:T progress.no_connections}" />
                    </Grid>
                </StackPanel>

                <DockPanel Margin="0,14,0,0" LastChildFill="False">
                    <Button x:Name="DetailsButton" Style="{StaticResource DialogButton}" Margin="0" Content="{l:T progress.show_details}" Click="Details_Click" />
                    <Button Style="{StaticResource DialogButton}" Content="{l:T progress.customize}" Click="Customize_Click" />
                    <Button DockPanel.Dock="Right" Style="{StaticResource DialogButton}" Content="{l:T common.cancel}" Click="Cancel_Click" />
                    <Button x:Name="PauseButton" DockPanel.Dock="Right" Style="{StaticResource DialogButton}" Content="{l:T progress.pause}" Click="Pause_Click" />
                </DockPanel>
            </StackPanel>
        </TabItem>

        <TabItem x:Name="SpeedTab" Header="{l:T progress.speed_limiter}">
            <StackPanel Margin="12">
                <StackPanel Orientation="Horizontal">
                    <CheckBox x:Name="LimitBox" VerticalAlignment="Center" Content="{l:T progress.limit_this_downloads_speed_to}" />
                    <TextBox x:Name="LimitKBBox" Width="70" Margin="8,0,6,0" Padding="4,2" AutomationProperties.Name="{l:T progress.speed_limit_in_kb_s}" />
                    <TextBlock VerticalAlignment="Center" Text="{l:T progress.kb_s}" />
                </StackPanel>
                <CheckBox x:Name="KeepLimitBox" Margin="0,10,0,0" Content="{l:T progress.keep_this_limit_when_download_is}" />
                <TextBlock x:Name="CurrentRateText" Margin="0,14,0,0" Foreground="{DynamicResource MutedText}" />
                <Button x:Name="HideSpeedTabButton" HorizontalAlignment="Right" Padding="10,3" Margin="0,16,0,0" Content="{l:T progress.hide_this_tab}" Click="HideSpeedTab_Click" />
            </StackPanel>
        </TabItem>

        <TabItem x:Name="WhenDoneTab" Header="{l:T progress.when_done}">
            <StackPanel Margin="12">
                <CheckBox x:Name="ShowCompleteBox" Content="{l:T progress.show_download_complete_dialog}" />
                <CheckBox x:Name="ExitBox" Margin="0,8,0,0" Content="{l:T progress.exit_adm_when_done}" />
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <CheckBox x:Name="TurnOffBox" VerticalAlignment="Center" Content="{l:T progress.turn_off_computer_when_done}" />
                    <ComboBox x:Name="TurnOffChoice" Width="120" Margin="8,0,0,0" SelectedIndex="0" AutomationProperties.Name="{l:T progress.how_to_turn_off_computer}">
                        <ComboBoxItem Content="{l:T progress.shut_down}" />
                        <ComboBoxItem Content="{l:T progress.sleep}" />
                        <ComboBoxItem Content="{l:T progress.hibernate}" />
                    </ComboBox>
                </StackPanel>
                <CheckBox x:Name="ForceBox" Margin="20,8,0,0" Content="{l:T progress.force_programs_to_close}" />
                <Button x:Name="HideWhenDoneTabButton" HorizontalAlignment="Right" Padding="10,3" Margin="0,16,0,0" Content="{l:T progress.hide_this_tab}" Click="HideWhenDoneTab_Click" />
            </StackPanel>
        </TabItem>
    </TabControl>
</local:ThemedWindow>
