<local:ThemedWindow x:Class="ADM.App.SaveProjectWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:ADM.App"
        xmlns:local="clr-namespace:ADM.App"
        Title="{l:T saveproject.title}" Width="440" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <StackPanel Margin="18">
        <TextBlock x:Name="MessageText" TextWrapping="Wrap" />
        <TextBox x:Name="NameBox" Padding="4,3" Margin="0,8,0,0" AutomationProperties.Name="{l:T grabber.project_name}" />
        <TextBlock x:Name="ProblemText" Foreground="{DynamicResource ErrorText}" TextWrapping="Wrap" Margin="0,4,0,0" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Style="{StaticResource DialogButton}" Content="{l:T saveproject.save}" IsDefault="True" Click="Save_Click" />
            <Button x:Name="DontSaveButton" Style="{StaticResource DialogButton}" Content="{l:T saveproject.dont_save}" Click="DontSave_Click" />
            <Button Style="{StaticResource DialogButton}" Content="{l:T common.cancel}" IsCancel="True" />
        </StackPanel>
    </StackPanel>
</local:ThemedWindow>
