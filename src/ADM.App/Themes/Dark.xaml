<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Surfaces -->
    <SolidColorBrush x:Key="WindowBg" Color="#14181F" />
    <SolidColorBrush x:Key="PanelBg" Color="#1B2029" />
    <SolidColorBrush x:Key="InputBg" Color="#1F2530" />
    <SolidColorBrush x:Key="ButtonBg" Color="#2A3240" />
    <SolidColorBrush x:Key="HoverBg" Color="#364154" />
    <SolidColorBrush x:Key="PressedBg" Color="#3E4A5E" />
    <SolidColorBrush x:Key="DisabledBg" Color="#1B2029" />
    <SolidColorBrush x:Key="MenuBg" Color="#1F2530" />
    <SolidColorBrush x:Key="HeaderBg" Color="#1B2029" />
    <SolidColorBrush x:Key="AltRowBg" Color="#181D25" />
    <SolidColorBrush x:Key="TrackBg" Color="#2A3240" />
    <SolidColorBrush x:Key="ToolTipBg" Color="#2A3240" />

    <!-- Text -->
    <SolidColorBrush x:Key="Text" Color="#E5E9F0" />
    <SolidColorBrush x:Key="MutedText" Color="#A3AEBD" />
    <SolidColorBrush x:Key="AccentText" Color="#93C5FD" />
    <SolidColorBrush x:Key="ErrorText" Color="#FCA5A5" />
    <SolidColorBrush x:Key="SyncText" Color="#4ADE80" />
    <SolidColorBrush x:Key="WarningText" Color="#FCD34D" />
    <SolidColorBrush x:Key="DisabledText" Color="#8F9BAC" />
    <SolidColorBrush x:Key="HoverText" Color="#E5E9F0" />

    <!-- Selection -->
    <SolidColorBrush x:Key="SelectionBg" Color="#1D4ED8" />
    <SolidColorBrush x:Key="SelectionText" Color="#FFFFFF" />
    <SolidColorBrush x:Key="InactiveSelectionBg" Color="#364154" />
    <SolidColorBrush x:Key="InactiveSelectionText" Color="#E5E9F0" />

    <!-- Lines and marks -->
    <SolidColorBrush x:Key="BorderBrush" Color="#2F3846" />
    <SolidColorBrush x:Key="ControlBorder" Color="#6E7C92" />
    <SolidColorBrush x:Key="FocusBorder" Color="#60A5FA" />
    <SolidColorBrush x:Key="Accent" Color="#3B82F6" />
    <SolidColorBrush x:Key="AccentSoft" Color="#1D4ED8" />
    <!-- The list's progress bars by state; AccentSoft fills a running one. -->
    <SolidColorBrush x:Key="DoneFill" Color="#1F3B2C" />
    <SolidColorBrush x:Key="FailedFill" Color="#991B1B" />
    <SolidColorBrush x:Key="WarningFill" Color="#92400E" />
    <SolidColorBrush x:Key="PausedFill" Color="#475569" />
    <SolidColorBrush x:Key="LiveFill" Color="#34D399" />
    <SolidColorBrush x:Key="ScrollThumb" Color="#66748A" />
    <SolidColorBrush x:Key="ScrollThumbHover" Color="#8391A6" />
</ResourceDictionary>
