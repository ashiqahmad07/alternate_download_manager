<local:ThemedWindow x:Class="ADM.App.FontWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:ADM.App"
        xmlns:local="clr-namespace:ADM.App"
        Title="{l:T font.font}" Width="520" Height="480" MinWidth="420" MinHeight="380"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Style="{StaticResource DialogButton}" Content="{l:T common.ok}" IsDefault="True" Click="Ok_Click" />
            <Button Style="{StaticResource DialogButton}" Content="{l:T common.cancel}" IsCancel="True" />
        </StackPanel>

        <!-- The preview keeps its own font, the choice, while the window around it stays as it is until OK. -->
        <Border DockPanel.Dock="Bottom" Margin="0,12,0,0" Padding="10" Height="84" Background="{DynamicResource PanelBg}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
            <TextBlock x:Name="PreviewText" VerticalAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                       Text="{l:T font.quick_brown_fox_jumps_over_lazy}" AutomationProperties.Name="{l:T font.preview}" />
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="90" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition />
            </Grid.RowDefinitions>
            <TextBlock Style="{StaticResource FieldLabel}" Text="{l:T font.font}" Margin="0,0,0,4" />
            <TextBlock Grid.Column="2" Style="{StaticResource FieldLabel}" Text="{l:T common.size}" Margin="0,0,0,4" />
            <ListBox x:Name="FamilyList" Grid.Row="1" AutomationProperties.Name="{l:T font.font}" SelectionChanged="Choice_Changed" />
            <ListBox x:Name="SizeList" Grid.Row="1" Grid.Column="2" AutomationProperties.Name="{l:T common.size}" SelectionChanged="Choice_Changed" />
        </Grid>
    </DockPanel>
</local:ThemedWindow>
