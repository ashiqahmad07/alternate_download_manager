<local:ThemedWindow x:Class="ADM.App.ProgressCustomizeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:ADM.App"
        xmlns:local="clr-namespace:ADM.App"
        Title="{l:T progresscustomize.download_window}" Width="460" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <StackPanel Margin="18">
        <TextBlock Text="{l:T progresscustomize.when_download_starts}" FontWeight="SemiBold" />
        <RadioButton x:Name="NormalView" Margin="0,8,0,0" GroupName="View" Content="{l:T progresscustomize.show_its_download_window}" />
        <RadioButton x:Name="MinimizedView" Margin="0,6,0,0" GroupName="View" Content="{l:T progresscustomize.keep_its_window_in_tray_menu}" />
        <RadioButton x:Name="HiddenView" Margin="0,6,0,0" GroupName="View" Content="{l:T progresscustomize.dont_open_window}" />
        <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" Foreground="{DynamicResource MutedText}"
                   Text="{l:T progresscustomize.downloads_started_by_queue_never_open}" />

        <TextBlock Margin="0,16,0,0" Text="{l:T progresscustomize.in_window}" FontWeight="SemiBold" />
        <CheckBox x:Name="SpeedTabBox" Margin="0,8,0,0" Content="{l:T progresscustomize.show_speed_limiter_tab}" />
        <CheckBox x:Name="WhenDoneTabBox" Margin="0,6,0,0" Content="{l:T progresscustomize.show_when_done_tab}" />
        <CheckBox x:Name="HideButtonsBox" Margin="0,6,0,0" Content="{l:T progresscustomize.show_hide_this_tab_buttons}" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Style="{StaticResource DialogButton}" Content="{l:T common.ok}" IsDefault="True" Click="Ok_Click" />
            <Button Style="{StaticResource DialogButton}" Content="{l:T common.cancel}" IsCancel="True" />
        </StackPanel>
    </StackPanel>
</local:ThemedWindow>
