<local:ThemedWindow x:Class="ADM.App.VideoToolsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:ADM.App"
        xmlns:local="clr-namespace:ADM.App"
        Title="{l:T videotools.title}" Width="560" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <StackPanel Margin="18">
        <TextBlock TextWrapping="Wrap" Text="{l:T videotools.intro}" />
        <Grid Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" FontWeight="SemiBold" Margin="0,0,14,0" Text="{l:T videotools.ytdlp}" />
            <TextBlock x:Name="YtDlpText" Grid.Row="0" Grid.Column="1" TextWrapping="Wrap" Foreground="{DynamicResource MutedText}" />
            <ProgressBar x:Name="YtDlpBar" Grid.Row="1" Grid.Column="1" Height="8" Margin="0,4,0,0" Maximum="100" Visibility="Collapsed" />
            <TextBlock Grid.Row="2" FontWeight="SemiBold" Margin="0,10,14,0" Text="{l:T videotools.runtime}" />
            <TextBlock x:Name="RuntimeText" Grid.Row="2" Grid.Column="1" Margin="0,10,0,0" TextWrapping="Wrap" Foreground="{DynamicResource MutedText}" />
            <ProgressBar x:Name="RuntimeBar" Grid.Row="3" Grid.Column="1" Height="8" Margin="0,4,0,0" Maximum="100" Visibility="Collapsed" />
            <TextBlock Grid.Row="4" FontWeight="SemiBold" Margin="0,10,14,0" Text="{l:T videotools.ffmpeg}" />
            <TextBlock x:Name="FfmpegText" Grid.Row="4" Grid.Column="1" Margin="0,10,0,0" TextWrapping="Wrap" Foreground="{DynamicResource MutedText}" />
            <ProgressBar x:Name="FfmpegBar" Grid.Row="5" Grid.Column="1" Height="8" Margin="0,4,0,0" Maximum="100" Visibility="Collapsed" />
        </Grid>
        <TextBlock x:Name="ResultText" Margin="0,14,0,0" TextWrapping="Wrap" Visibility="Collapsed" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="FetchButton" Style="{StaticResource DialogButton}" IsDefault="True" Click="Fetch_Click" />
            <Button Style="{StaticResource DialogButton}" Content="{l:T common.close}" IsCancel="True" />
        </StackPanel>
    </StackPanel>
</local:ThemedWindow>
