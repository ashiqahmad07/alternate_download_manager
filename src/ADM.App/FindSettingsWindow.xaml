<local:ThemedWindow x:Class="ADM.App.FindSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:ADM.App"
        xmlns:local="clr-namespace:ADM.App"
        Title="{l:T findsettings.find_settings}" Width="420" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <StackPanel Margin="18">
        <TextBlock Text="{l:T findsettings.look_in}" FontWeight="SemiBold" />
        <CheckBox x:Name="NamesBox" Margin="0,8,0,0" Content="{l:T findsettings.file_names}" />
        <CheckBox x:Name="DescriptionsBox" Margin="0,6,0,0" Content="{l:T findsettings.descriptions}" />
        <CheckBox x:Name="AddressesBox" Margin="0,6,0,0" AutomationProperties.Name="{l:T findsettings.addresses_site_link_page_it_came}">
            <TextBlock Text="{l:T findsettings.addresses_site_link_page_it_came}" TextWrapping="Wrap" />
        </CheckBox>
        <CheckBox x:Name="MatchCaseBox" Margin="0,16,0,0" Content="{l:T findsettings.match_case}" />
        <CheckBox x:Name="WholeStringBox" Margin="0,6,0,0" Content="{l:T findsettings.whole_string_only}" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button x:Name="OkButton" Style="{StaticResource DialogButton}" Content="{l:T common.ok}" IsDefault="True" Click="Ok_Click" />
            <Button Style="{StaticResource DialogButton}" Content="{l:T common.cancel}" IsCancel="True" />
        </StackPanel>
    </StackPanel>
</local:ThemedWindow>
