<local:ThemedWindow x:Class="ADM.App.ToolbarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:ADM.App"
        xmlns:local="clr-namespace:ADM.App"
        Title="{l:T toolbar.customize_toolbar}" Width="600" Height="440" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Style="{StaticResource DialogButton}" Content="{l:T common.ok}" IsDefault="True" Click="Ok_Click" />
            <Button Style="{StaticResource DialogButton}" Content="{l:T common.cancel}" IsCancel="True" />
        </StackPanel>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition />
            </Grid.RowDefinitions>
            <TextBlock Text="{l:T toolbar.available_buttons}" Margin="0,0,0,6" />
            <ListBox x:Name="AvailableList" Grid.Row="1" AutomationProperties.Name="{l:T toolbar.available_buttons}" />
            <StackPanel Grid.Row="1" Grid.Column="1" Margin="10,0" VerticalAlignment="Center" Width="90">
                <Button Content="{l:T common.add}" Padding="0,4" Click="Add_Click" />
                <Button Content="{l:T toolbar.remove}" Padding="0,4" Margin="0,6,0,0" Click="Remove_Click" />
            </StackPanel>
            <TextBlock Grid.Column="2" Text="{l:T toolbar.shown_on_toolbar}" Margin="0,0,0,6" />
            <ListBox x:Name="ShownList" Grid.Row="1" Grid.Column="2" AutomationProperties.Name="{l:T toolbar.shown_on_toolbar}" />
            <StackPanel Grid.Row="1" Grid.Column="3" Margin="10,0,0,0" MinWidth="90">
                <Button Content="{l:T toolbar.move_up}" Padding="0,4" Click="MoveUp_Click" />
                <Button Content="{l:T toolbar.move_down}" Padding="0,4" Margin="0,6,0,0" Click="MoveDown_Click" />
                <Button Content="{l:T toolbar.reset}" Padding="0,4" Margin="0,18,0,0" Click="Reset_Click" />
            </StackPanel>
        </Grid>
    </DockPanel>
</local:ThemedWindow>
