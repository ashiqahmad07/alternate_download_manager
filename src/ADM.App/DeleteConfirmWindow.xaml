<local:ThemedWindow x:Class="ADM.App.DeleteConfirmWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:ADM.App"
        xmlns:local="clr-namespace:ADM.App"
        Title="{l:T deleteconfirm.delete_downloads}" Width="500" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <StackPanel Margin="18">
        <StackPanel x:Name="FinishedPanel">
            <TextBlock x:Name="FinishedText" TextWrapping="Wrap" />
            <CheckBox x:Name="DeleteFilesBox" Margin="0,10,0,0" Content="{l:T deleteconfirm.also_delete_downloaded_files_from_disk}" />
            <CheckBox x:Name="DontAskFinishedBox" Margin="0,6,0,0" Content="{l:T deleteconfirm.dont_ask_again_before_removing_finished}" />
        </StackPanel>
        <StackPanel x:Name="UnfinishedPanel" Margin="0,16,0,0">
            <TextBlock x:Name="UnfinishedText" TextWrapping="Wrap" />
            <CheckBox x:Name="DontAskUnfinishedBox" Margin="0,10,0,0" Content="{l:T deleteconfirm.dont_ask_again_before_deleting_unfinished}" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Style="{StaticResource DialogButton}" Content="{l:T common.delete}" IsDefault="True" Click="Delete_Click" />
            <Button Style="{StaticResource DialogButton}" Content="{l:T common.cancel}" IsCancel="True" />
        </StackPanel>
    </StackPanel>
</local:ThemedWindow>
