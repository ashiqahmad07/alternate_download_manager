<local:ThemedWindow x:Class="ADM.App.ZipPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:ADM.App"
        xmlns:local="clr-namespace:ADM.App"
        Title="{l:T zippreview.preview_zip}" Width="760" Height="520" MinWidth="520" MinHeight="320"
        WindowStartupLocation="CenterOwner" KeyDown="Window_KeyDown">
    <DockPanel Margin="16">
        <TextBlock x:Name="MessageText" DockPanel.Dock="Top" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />

        <DockPanel DockPanel.Dock="Bottom" Margin="0,14,0,0" LastChildFill="False">
            <CheckBox x:Name="SelectAllBox" VerticalAlignment="Center" Content="{l:T zippreview.select_all}" IsEnabled="False"
                      Checked="SelectAll_Changed" Unchecked="SelectAll_Changed" />
            <TextBlock x:Name="CountText" Style="{StaticResource FieldLabel}" Margin="12,0,0,0" />
            <Button DockPanel.Dock="Right" Style="{StaticResource DialogButton}" Content="{l:T common.close}" Click="Close_Click" />
            <Button x:Name="StopButton" DockPanel.Dock="Right" Style="{StaticResource DialogButton}" Content="{l:T common.stop}" Click="Stop_Click" Visibility="Collapsed" />
            <Button x:Name="ExtractButton" DockPanel.Dock="Right" Style="{StaticResource DialogButton}" Content="{l:T zippreview.extract_to_2}" Click="Extract_Click" IsEnabled="False" />
        </DockPanel>

        <ProgressBar x:Name="ExtractProgress" DockPanel.Dock="Bottom" Height="10" Margin="0,10,0,0" Visibility="Collapsed"
                     AutomationProperties.Name="{l:T zippreview.extracting_2}" />

        <DataGrid x:Name="EntryList" Margin="0,10,0,0" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                  HeadersVisibility="Column" GridLinesVisibility="None" CanUserResizeRows="False" RowHeight="{DynamicResource AppRowHeight}"
                  BorderBrush="{DynamicResource BorderBrush}" AutomationProperties.Name="{l:T zippreview.files_in_archive}">
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="" Width="30" CanUserSort="False" CanUserResize="False">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding Checked, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                      AutomationProperties.Name="{Binding Name}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="{l:T common.name}" Binding="{Binding Name}" Width="*" />
                <DataGridTextColumn Header="{l:T zippreview.packed}" Binding="{Binding PackedText}" SortMemberPath="Entry.Packed" Width="90" />
                <DataGridTextColumn Header="{l:T common.size}" Binding="{Binding SizeText}" SortMemberPath="Entry.Size" Width="90" />
                <DataGridTextColumn Header="{l:T zippreview.modified}" Binding="{Binding ModifiedText}" SortMemberPath="Entry.Modified" Width="140" />
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</local:ThemedWindow>
