{
  "manifest_version": 3,
  "name": "Alternate Download Manager Integration",
  "description": "Sends browser downloads and detected media streams to Alternate Download Manager.",
  "version": "1.1.0",
  "browser_specific_settings": { "gecko": { "id": "integration@adm", "strict_min_version": "128.0", "data_collection_permissions": { "required": ["none"] } } },
  "background": { "scripts": ["background.js"] },
  "content_scripts": [
    { "matches": ["<all_urls>"], "js": ["content.js"], "all_frames": true, "run_at": "document_start" }
  ],
  "icons": { "16": "icon16.png", "32": "icon32.png", "48": "icon48.png", "128": "icon128.png" },
  "action": { "default_title": "ADM", "default_popup": "popup.html", "default_icon": { "16": "icon16.png", "32": "icon32.png" } },
  "permissions": ["downloads", "nativeMessaging", "cookies", "contextMenus", "webRequest", "storage", "tabs", "scripting"],
  "host_permissions": ["<all_urls>"]
}
