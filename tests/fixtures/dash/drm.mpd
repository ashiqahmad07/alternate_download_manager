<?xml version="1.0" encoding="UTF-8"?>
<MPD xmlns="urn:mpeg:dash:schema:mpd:2011" type="static" mediaPresentationDuration="PT6S">
  <Period>
    <AdaptationSet mimeType="video/mp4">
      <ContentProtection schemeIdUri="urn:mpeg:dash:mp4protection:2011" value="cenc" />
      <SegmentTemplate timescale="1" duration="2" media="$Number$.m4s" />
      <Representation id="protected" bandwidth="1500000" />
    </AdaptationSet>
    <AdaptationSet mimeType="audio/mp4">
      <SegmentTemplate timescale="1" duration="2" media="audio-$Number$.m4s" />
      <Representation id="clear" bandwidth="128000" />
    </AdaptationSet>
  </Period>
</MPD>
