<?xml version="1.0" encoding="UTF-8"?>
<MPD xmlns="urn:mpeg:dash:schema:mpd:2011" type="static" mediaPresentationDuration="PT6S">
  <Period>
    <AdaptationSet mimeType="video/webm" codecs="vp09.00.10.08">
      <Representation id="plain" bandwidth="1000000" width="1920" height="1080">
        <BaseURL>plain.webm</BaseURL>
      </Representation>
      <Representation id="no-index" bandwidth="500000">
        <BaseURL>no-index.webm</BaseURL>
        <SegmentBase>
          <Initialization range="0-99" />
        </SegmentBase>
      </Representation>
    </AdaptationSet>
    <AdaptationSet mimeType="audio/webm" codecs="opus">
      <Representation id="sound" bandwidth="96000">
        <BaseURL>sound.webm</BaseURL>
      </Representation>
    </AdaptationSet>
  </Period>
</MPD>
